<?xml version="1.0" encoding="UTF-8"?>
<ExtensionList>
  <Extension Id="com.refire.ppro.main">
    <HostList>
      <!-- with the panel open in Premiere, hit http://localhost:8089 in Chrome for the
           console. 8089, not the AE panel's 8088: both can be installed at once. -->
      <Host Name="PPRO" Port="8089"/>
    </HostList>
  </Extension>
</ExtensionList>
